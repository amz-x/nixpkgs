         # In include mode, the Proton VPN app should always be included in the VPN
         # so that it can establish the local agent connection to the VPN server.
         config = config_by_uid[process.uid]
-        if config.mode == SplitTunnelingMode.INCLUDE and cls.VPN_APP_BIN in process.exe:
+        if config.mode == SplitTunnelingMode.INCLUDE and (
+                cls.VPN_APP_BIN in process.exe or cls.VPN_APP_BIN in process.cmdline
+        ):
             return set([cls.VPN_APP_BIN])
 
         matches = set()
         for app_path in config.app_paths:
             if not app_path:
                 continue
-            if process.exe.startswith(app_path):
+            if any(process.exe.startswith(path) for path in cls._resolve_app_path(app_path)):
                 matches.add(app_path)
 
         return matches
 
+    @staticmethod
+    def _resolve_app_path(app_path: str) -> set[str]:
+        """
+        Returns the configured path together with the paths a running process started
+        from it reports as its exe: the symlink target (e.g. /run/current-system/sw/bin/foo
+        -> /nix/store/...-foo/bin/foo) and the Nix wrapper target (.foo-wrapped).
+        """
+        real_path = os.path.realpath(app_path)
+        directory, name = os.path.split(real_path)
+        return {app_path, real_path, os.path.join(directory, f".{name}-wrapped")}
+
