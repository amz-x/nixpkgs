+    private static void connect_systemd_scope (AppLaunchContext context) {
+        context.launched.connect ((appinfo, platform_data) => start_systemd_scope.begin (appinfo, platform_data));
+    }
+
+    private static async void start_systemd_scope (GLib.AppInfo appinfo, Variant platform_data) {
+        // GLib always sets "pid", but it is 0 when the app was activated over D-Bus
+        int pid;
+        if (!platform_data.lookup ("pid", "i", out pid)) {
+            return;
+        }
+
+        var app_name = appinfo.get_id () ?? appinfo.get_executable ();
+        // if we got a path, use the binary name only
+        if (app_name.has_prefix ("/")) {
+            app_name = Path.get_basename (app_name);
+        } else if (app_name.has_suffix (".desktop")) {
+            app_name = app_name.substring (0, app_name.length - 8);
+        }
+
+        DBusConnection connection;
+        try {
+            connection = yield Bus.get (SESSION);
+        } catch (Error e) {
+            critical ("Couldn't connect to DBus: %s", e.message);
+            return;
+        }
+
+        // D-Bus activated apps are started by the bus daemon, not by us, so look up
+        // the pid of the bus name, which is the app ID for DBusActivatable apps.
+        // GLib emits "launched" after the activation call returns, so the name is owned by now.
+        if (pid == 0) {
+            try {
+                var reply = yield connection.call (
+                    "org.freedesktop.DBus",
+                    "/org/freedesktop/DBus",
+                    "org.freedesktop.DBus",
+                    "GetConnectionUnixProcessID",
+                    new Variant ("(s)", app_name),
+                    new VariantType ("(u)"),
+                    NONE,
+                    1000,
+                    null
+                );
+
+                uint32 bus_pid;
+                reply.get ("(u)", out bus_pid);
+                pid = (int) bus_pid;
+            } catch (Error e) {
+                warning ("Couldn't get pid of D-Bus activated app %s: %s", app_name, e.message);
+                return;
+            }
+        }
+
+        var string_builder = new StringBuilder.sized (app_name.length);
+        for (var i = 0; i < app_name.length; i++) {
+            var c = app_name[i];
+            if (c.isalnum () || c == ':' || c == '_' || c == '.') {
+                string_builder.append_c (c);
+            } else {
+                string_builder.append_printf ("\\x%02x", c);
+            }
+        }
+
+        var builder = new VariantBuilder (new VariantType ("(ssa(sv)a(sa(sv)))"));
+        builder.add ("s", "app-pantheon-%s-%d.scope".printf (string_builder.free_and_steal (), pid));
+        builder.add ("s", "fail");
+
+        builder.open (new VariantType ("a(sv)"));
+        builder.add ("(sv)", "Description", new Variant.string ("Application launched by %s".printf (GLib.Application.get_default ().application_id)));
+        builder.add ("(sv)", "PIDs", new Variant.array (VariantType.UINT32, { (uint32) pid }));
+
+        // Default to let systemd garbage collect failed applications we launched.
+        builder.add ("(sv)", "CollectMode", new Variant.string ("inactive-or-failed"));
+        builder.close ();
+
+        builder.open (new VariantType ("a(sa(sv))"));
+        builder.close ();
+
+        try {
+            yield connection.call (
+                "org.freedesktop.systemd1",
+                "/org/freedesktop/systemd1",
+                "org.freedesktop.systemd1.Manager",
+                "StartTransientUnit",
+                builder.end (),
+                new VariantType ("(o)"),
+                NO_AUTO_START,
+                1000,
+                null
+            );
+        } catch (Error e) {
+            // Activating an already running D-Bus app again resolves to the same pid and scope
+            if (DBusError.get_remote_error (e) == "org.freedesktop.systemd1.UnitExists") {
+                return;
+            }
+
+            warning ("Couldn't put an app into Systemd scope: %s", e.message);
+        }
+    }
