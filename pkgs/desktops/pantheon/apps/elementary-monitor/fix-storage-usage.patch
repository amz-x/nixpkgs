+    // finds the drive a block device lives on, following device mapper
+    // slaves (e.g. LUKS, LVM); returns null if it spans multiple drives
+    private Disk? find_disk_for_block (string block_name) {
+        var parent = storage_parser.get_parent_name (block_name);
+        if (disks.has_key ("/dev/" + parent)) {
+            return disks["/dev/" + parent];
+        }
+
+        if (!block_name.has_prefix ("dm-")) {
+            return null;
+        }
+
+        Disk? found = null;
+        foreach (var slave_name in storage_parser.get_slaves_names (block_name)) {
+            var disk = find_disk_for_block (slave_name);
+            if (disk == null || (found != null && found != disk)) {
+                return null;
+            }
+            found = disk;
+        }
+
+        return found;
+    }
