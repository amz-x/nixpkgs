+    // Static so that the filter's closure doesn't hold a reference to this
+    // page: the filter ends up in a model bound to one of its own flowboxes
+    private static Gtk.CustomFilter new_recent_filter () {
+        var datetime = new GLib.DateTime.now_local ().add_months (-6);
+        return new Gtk.CustomFilter ((obj) => {
+            var package = (AppCenterCore.Package) obj;
+
+            var newest_release = package.get_newest_release ();
+            if (newest_release == null) {
+                return false;
+            }
+
+            // Don't add packages over 6 months old
+            if (newest_release.get_timestamp () < datetime.to_unix ()) {
+                return false;
+            }
+
+            return true;
+        });
+    }
