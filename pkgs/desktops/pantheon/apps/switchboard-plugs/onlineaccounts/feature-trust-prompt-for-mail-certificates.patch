diff --git a/src/Dialogs/Imap/CamelSession.vala b/src/Dialogs/Imap/CamelSession.vala
index 7f544b2..b44ae0f 100644
--- a/src/Dialogs/Imap/CamelSession.vala
+++ b/src/Dialogs/Imap/CamelSession.vala
@@ -22,6 +22,9 @@ public class OnlineAccounts.CamelSession : Camel.Session {
 
     private static CamelSession? session = null;
 
+    /* The window trust prompts are shown for */
+    public weak Gtk.Window? parent_window { get; set; default = null; }
+
     public static unowned CamelSession get_default () {
         if (session == null) {
             session = new CamelSession ();
@@ -42,4 +45,59 @@ public class OnlineAccounts.CamelSession : Camel.Session {
         set_online (true);
         user_alert.connect ((service, type, message) => { warning (message); });
     }
+
+    /*
+     * Camel rejects certificates it can't verify, like self-signed ones, unless
+     * the session asks the user. Camel stores the answer in its certificate
+     * database, which mail clients using the same data directory read too.
+     */
+    public override Camel.CertTrust trust_prompt (Camel.Service service, GLib.TlsCertificate certificate, GLib.TlsCertificateFlags errors) {
+        var settings = service.ref_settings ();
+        if (!(settings is Camel.NetworkSettings)) {
+            return Camel.CertTrust.UNKNOWN;
+        }
+
+        var host = ((Camel.NetworkSettings) settings).dup_host ();
+        var source_extension = (service is Camel.Transport) ? E.SOURCE_EXTENSION_MAIL_TRANSPORT : E.SOURCE_EXTENSION_MAIL_ACCOUNT;
+
+        var response = E.TrustPromptResponse.UNKNOWN;
+
+        // Camel calls this from its worker thread, but the prompt has to run on the main thread
+        if (GLib.MainContext.default ().is_owner ()) {
+            response = E.trust_prompt_run_modal (parent_window, source_extension, service.display_name, host, certificate.certificate_pem, errors, null);
+        } else {
+            var mutex = GLib.Mutex ();
+            var cond = GLib.Cond ();
+            var answered = false;
+
+            GLib.MainContext.default ().invoke (() => {
+                var main_response = E.trust_prompt_run_modal (parent_window, source_extension, service.display_name, host, certificate.certificate_pem, errors, null);
+
+                mutex.lock ();
+                response = main_response;
+                answered = true;
+                cond.signal ();
+                mutex.unlock ();
+
+                return GLib.Source.REMOVE;
+            });
+
+            mutex.lock ();
+            while (!answered) {
+                cond.wait (mutex);
+            }
+            mutex.unlock ();
+        }
+
+        switch (response) {
+            case E.TrustPromptResponse.ACCEPT:
+                return Camel.CertTrust.FULLY;
+            case E.TrustPromptResponse.ACCEPT_TEMPORARILY:
+                return Camel.CertTrust.TEMPORARY;
+            case E.TrustPromptResponse.REJECT:
+                return Camel.CertTrust.NEVER;
+            default:
+                return Camel.CertTrust.UNKNOWN;
+        }
+    }
 }
