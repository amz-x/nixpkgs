diff --git a/src/Widgets/RemoteDesktopPage.vala b/src/Widgets/RemoteDesktopPage.vala
new file mode 100644
index 0000000..4173f86
--- /dev/null
+++ b/src/Widgets/RemoteDesktopPage.vala
@@ -0,0 +1,211 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * SPDX-FileCopyrightText: 2023-2026 elementary, Inc. (https://elementary.io)
+ */
+
+public class Sharing.Widgets.RemoteDesktopPage : Switchboard.SettingsPage {
+    private const uint DEFAULT_PORT = 3389;
+
+    private Backend.RemoteDesktop remote_desktop;
+    private Gtk.Label address_label;
+    private Gtk.Entry username_entry;
+    private Gtk.PasswordEntry password_entry;
+    private uint save_timeout_id = 0;
+    private bool syncing = false;
+    private string? error_message = null;
+
+    public RemoteDesktopPage () {
+        Object (activatable: true);
+    }
+
+    construct {
+        title = _("Remote Desktop");
+        icon = new ThemedIcon ("preferences-desktop-remote-desktop");
+        show_end_title_buttons = true;
+
+        remote_desktop = new Backend.RemoteDesktop ();
+
+        var address_header = new Granite.HeaderLabel (_("Address")) {
+            secondary_text = _("Connect to this computer from another device using a Remote Desktop (RDP) app.")
+        };
+
+        address_label = new Gtk.Label ("") {
+            halign = START,
+            selectable = true
+        };
+        address_label.add_css_class (Granite.STYLE_CLASS_H3_LABEL);
+
+        var control_switch = new Gtk.Switch () {
+            valign = CENTER
+        };
+
+        var control_label = new Gtk.Label (_("Allow connected devices to control this computer:")) {
+            halign = END,
+            mnemonic_widget = control_switch
+        };
+
+        var control_box = new Gtk.Box (HORIZONTAL, 12);
+        control_box.append (control_label);
+        control_box.append (control_switch);
+
+        var login_header = new Granite.HeaderLabel (_("Login")) {
+            secondary_text = _("Remote devices have to sign in with this user name and password.")
+        };
+
+        username_entry = new Gtk.Entry () {
+            hexpand = true
+        };
+
+        var username_label = new Gtk.Label (_("User name:")) {
+            halign = END,
+            mnemonic_widget = username_entry
+        };
+
+        password_entry = new Gtk.PasswordEntry () {
+            hexpand = true,
+            show_peek_icon = true
+        };
+
+        var password_label = new Gtk.Label (_("Password:")) {
+            halign = END,
+            mnemonic_widget = password_entry
+        };
+
+        var login_grid = new Gtk.Grid () {
+            column_spacing = 12,
+            row_spacing = 6
+        };
+        login_grid.attach (username_label, 0, 0);
+        login_grid.attach (username_entry, 1, 0);
+        login_grid.attach (password_label, 0, 1);
+        login_grid.attach (password_entry, 1, 1);
+
+        var address_box = new Gtk.Box (VERTICAL, 6);
+        address_box.append (address_header);
+        address_box.append (address_label);
+
+        var login_box = new Gtk.Box (VERTICAL, 6);
+        login_box.append (login_header);
+        login_box.append (login_grid);
+
+        var box = new Gtk.Box (VERTICAL, 24);
+        box.append (address_box);
+        box.append (control_box);
+        box.append (login_box);
+
+        child = box;
+
+        var settings = remote_desktop.rdp_settings;
+        settings.bind ("view-only", control_switch, "active", INVERT_BOOLEAN);
+        settings.changed["port"].connect (update_address);
+        settings.changed["enable"].connect (() => {
+            syncing = true;
+            status_switch.active = settings.get_boolean ("enable");
+            syncing = false;
+            set_service_state ();
+        });
+
+        status_switch.active = settings.get_boolean ("enable");
+        status_switch.notify["active"].connect (() => {
+            if (!syncing) {
+                set_enabled.begin (status_switch.active);
+            }
+        });
+
+        username_entry.changed.connect (queue_save_credentials);
+        password_entry.changed.connect (queue_save_credentials);
+
+        update_address ();
+        set_service_state ();
+        load_credentials.begin ();
+    }
+
+    private async void set_enabled (bool enabled) {
+        error_message = null;
+
+        try {
+            yield remote_desktop.set_enabled (enabled);
+        } catch (Error e) {
+            critical ("Unable to %s remote desktop: %s", enabled ? "enable" : "disable", e.message);
+            error_message = e.message;
+
+            syncing = true;
+            status_switch.active = remote_desktop.rdp_settings.get_boolean ("enable");
+            syncing = false;
+        }
+
+        set_service_state ();
+
+        // Credentials are generated the first time remote desktop is enabled
+        if (enabled) {
+            yield load_credentials ();
+        }
+    }
+
+    private async void load_credentials () {
+        string? username, password;
+        try {
+            yield remote_desktop.get_credentials (out username, out password);
+        } catch (Error e) {
+            warning ("Unable to read remote desktop credentials: %s", e.message);
+            return;
+        }
+
+        syncing = true;
+        username_entry.text = username ?? "";
+        password_entry.text = password ?? "";
+        syncing = false;
+    }
+
+    private void queue_save_credentials () {
+        if (syncing) {
+            return;
+        }
+
+        if (save_timeout_id != 0) {
+            Source.remove (save_timeout_id);
+        }
+
+        save_timeout_id = Timeout.add (500, () => {
+            save_timeout_id = 0;
+
+            if (username_entry.text != "" && password_entry.text != "") {
+                remote_desktop.set_credentials.begin (username_entry.text, password_entry.text, (obj, res) => {
+                    try {
+                        remote_desktop.set_credentials.end (res);
+                    } catch (Error e) {
+                        critical ("Unable to save remote desktop credentials: %s", e.message);
+                    }
+                });
+            }
+
+            return Source.REMOVE;
+        });
+    }
+
+    private void update_address () {
+        var port = remote_desktop.rdp_settings.get_value ("port").get_uint16 ();
+        var address = "rdp://%s".printf (Environment.get_host_name ());
+        if (port != DEFAULT_PORT) {
+            address += ":%u".printf (port);
+        }
+
+        address_label.label = address;
+    }
+
+    private void set_service_state () {
+        if (error_message != null) {
+            description = _("Remote Desktop settings could not be changed: %s").printf (error_message);
+            status = _("Not Available");
+            status_type = ERROR;
+        } else if (remote_desktop.rdp_settings.get_boolean ("enable")) {
+            description = _("While enabled, other devices can see this computer's screen and, if allowed, control it after signing in.");
+            status = _("Enabled");
+            status_type = SUCCESS;
+        } else {
+            description = _("While disabled, this computer's screen can not be viewed or controlled from other devices.");
+            status = _("Disabled");
+            status_type = OFFLINE;
+        }
+    }
+}
