diff --git a/src/Backend/Gnutls.c b/src/Backend/Gnutls.c
new file mode 100644
index 0000000..9511023
--- /dev/null
+++ b/src/Backend/Gnutls.c
@@ -0,0 +1,108 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * SPDX-FileCopyrightText: 2026 elementary, Inc. (https://elementary.io)
+ */
+
+#include <string.h>
+#include <time.h>
+#include <gio/gio.h>
+#include <gnutls/gnutls.h>
+#include <gnutls/crypto.h>
+#include <gnutls/x509.h>
+
+#define CERTIFICATE_LIFETIME_DAYS 730
+
+static gboolean
+check_gnutls (int ret, const char *what, GError **error)
+{
+    if (ret >= 0) {
+        return TRUE;
+    }
+
+    g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED, "Failed to %s: %s", what, gnutls_strerror (ret));
+    return FALSE;
+}
+
+/*
+ * Creates a self-signed certificate and its private key for the RDP server
+ * and writes them to the given paths in PEM format.
+ */
+gboolean
+sharing_backend_generate_tls_certificate (const char *cert_path, const char *key_path, const char *common_name, GError **error)
+{
+    gnutls_x509_privkey_t key = NULL;
+    gnutls_x509_crt_t crt = NULL;
+    gnutls_datum_t key_pem = { NULL, 0 };
+    gnutls_datum_t crt_pem = { NULL, 0 };
+    unsigned char serial[16];
+    time_t now = time (NULL);
+    gboolean success = FALSE;
+
+    if (!check_gnutls (gnutls_x509_privkey_init (&key), "initialize private key", error) ||
+        !check_gnutls (gnutls_x509_privkey_generate (key, GNUTLS_PK_RSA, 4096, 0), "generate private key", error) ||
+        !check_gnutls (gnutls_x509_crt_init (&crt), "initialize certificate", error) ||
+        !check_gnutls (gnutls_x509_crt_set_version (crt, 3), "set certificate version", error) ||
+        !check_gnutls (gnutls_rnd (GNUTLS_RND_NONCE, serial, sizeof (serial)), "generate serial number", error)) {
+        goto out;
+    }
+
+    /* Serial numbers must be positive */
+    serial[0] &= 0x7f;
+
+    if (!check_gnutls (gnutls_x509_crt_set_serial (crt, serial, sizeof (serial)), "set serial number", error) ||
+        !check_gnutls (gnutls_x509_crt_set_activation_time (crt, now), "set activation time", error) ||
+        !check_gnutls (gnutls_x509_crt_set_expiration_time (crt, now + (time_t) CERTIFICATE_LIFETIME_DAYS * 24 * 60 * 60), "set expiration time", error) ||
+        !check_gnutls (gnutls_x509_crt_set_dn_by_oid (crt, GNUTLS_OID_X520_COMMON_NAME, 0, common_name, strlen (common_name)), "set common name", error) ||
+        !check_gnutls (gnutls_x509_crt_set_key (crt, key), "set certificate key", error) ||
+        !check_gnutls (gnutls_x509_crt_set_key_usage (crt, GNUTLS_KEY_DIGITAL_SIGNATURE | GNUTLS_KEY_KEY_ENCIPHERMENT), "set key usage", error) ||
+        !check_gnutls (gnutls_x509_crt_set_key_purpose_oid (crt, GNUTLS_KP_TLS_WWW_SERVER, 0), "set key purpose", error) ||
+        !check_gnutls (gnutls_x509_crt_sign2 (crt, crt, key, GNUTLS_DIG_SHA256, 0), "sign certificate", error) ||
+        !check_gnutls (gnutls_x509_privkey_export2 (key, GNUTLS_X509_FMT_PEM, &key_pem), "export private key", error) ||
+        !check_gnutls (gnutls_x509_crt_export2 (crt, GNUTLS_X509_FMT_PEM, &crt_pem), "export certificate", error)) {
+        goto out;
+    }
+
+    if (!g_file_set_contents_full (key_path, (const char *) key_pem.data, key_pem.size, G_FILE_SET_CONTENTS_CONSISTENT, 0600, error) ||
+        !g_file_set_contents_full (cert_path, (const char *) crt_pem.data, crt_pem.size, G_FILE_SET_CONTENTS_CONSISTENT, 0644, error)) {
+        goto out;
+    }
+
+    success = TRUE;
+
+out:
+    gnutls_free (key_pem.data);
+    gnutls_free (crt_pem.data);
+    if (crt != NULL) {
+        gnutls_x509_crt_deinit (crt);
+    }
+    if (key != NULL) {
+        gnutls_x509_privkey_deinit (key);
+    }
+
+    return success;
+}
+
+/*
+ * Returns a random password for the RDP credentials, or NULL on failure.
+ * Ambiguous characters (0/O, 1/l/I) are left out so it can be read off the screen.
+ */
+char *
+sharing_backend_generate_password (void)
+{
+    static const char characters[] = "abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789";
+    unsigned char random[16];
+    char *password;
+
+    if (gnutls_rnd (GNUTLS_RND_KEY, random, sizeof (random)) < 0) {
+        return NULL;
+    }
+
+    password = g_malloc (sizeof (random) + 1);
+    for (gsize i = 0; i < sizeof (random); i++) {
+        /* 256 is not a multiple of the alphabet size; the bias is negligible here */
+        password[i] = characters[random[i] % (sizeof (characters) - 1)];
+    }
+    password[sizeof (random)] = '\0';
+
+    return password;
+}
diff --git a/src/Backend/RemoteDesktop.vala b/src/Backend/RemoteDesktop.vala
new file mode 100644
index 0000000..7154838
--- /dev/null
+++ b/src/Backend/RemoteDesktop.vala
@@ -0,0 +1,145 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ * SPDX-FileCopyrightText: 2026 elementary, Inc. (https://elementary.io)
+ */
+
+namespace Sharing.Backend {
+    [CCode (cname = "sharing_backend_generate_tls_certificate")]
+    private extern bool generate_tls_certificate (string cert_path, string key_path, string common_name) throws GLib.Error;
+
+    [CCode (cname = "sharing_backend_generate_password")]
+    private extern string? generate_password ();
+
+    [DBus (name = "org.freedesktop.systemd1.Manager")]
+    private interface SystemdManager : Object {
+        public abstract async void enable_unit_files (string[] files, bool runtime, bool force, out bool carries_install_info, out UnitFileChange[] changes) throws Error;
+        public abstract async void disable_unit_files (string[] files, bool runtime, out UnitFileChange[] changes) throws Error;
+        public abstract async ObjectPath start_unit (string name, string mode) throws Error;
+        public abstract async ObjectPath stop_unit (string name, string mode) throws Error;
+    }
+
+    private struct UnitFileChange {
+        string type;
+        string filename;
+        string destination;
+    }
+
+    /*
+     * Configures the RDP server of GNOME Remote Desktop for the current user session.
+     *
+     * The daemon only serves RDP once it is enabled in GSettings, has a TLS
+     * certificate and key, and finds credentials in the keyring, so all three
+     * are set up here before the daemon is started.
+     */
+    public class RemoteDesktop : Object {
+        public const string RDP_SCHEMA = "org.gnome.desktop.remote-desktop.rdp";
+        private const string VNC_SCHEMA = "org.gnome.desktop.remote-desktop.vnc";
+        private const string SERVICE = "gnome-remote-desktop.service";
+
+        public Settings rdp_settings { get; private set; }
+
+        private Secret.Schema credentials_schema;
+
+        public static bool is_supported () {
+            return SettingsSchemaSource.get_default ().lookup (RDP_SCHEMA, true) != null;
+        }
+
+        construct {
+            rdp_settings = new Settings (RDP_SCHEMA);
+            // Must match the schema gnome-remote-desktop looks the credentials up with
+            credentials_schema = new Secret.Schema (
+                "org.gnome.RemoteDesktop.RdpCredentials", Secret.SchemaFlags.NONE,
+                "credentials", Secret.SchemaAttributeType.STRING
+            );
+        }
+
+        public async void get_credentials (out string? username, out string? password) throws Error {
+            username = null;
+            password = null;
+
+            var serialized = yield Secret.password_lookupv (credentials_schema, new HashTable<string, string> (str_hash, str_equal), null);
+            if (serialized == null) {
+                return;
+            }
+
+            var credentials = Variant.parse (new VariantType ("a{sv}"), serialized);
+            credentials.lookup ("username", "s", out username);
+            credentials.lookup ("password", "s", out password);
+        }
+
+        public async void set_credentials (string username, string password) throws Error {
+            var builder = new VariantBuilder (new VariantType ("a{sv}"));
+            builder.add ("{sv}", "username", new Variant.string (username));
+            builder.add ("{sv}", "password", new Variant.string (password));
+
+            yield Secret.password_storev (
+                credentials_schema,
+                new HashTable<string, string> (str_hash, str_equal),
+                Secret.COLLECTION_DEFAULT,
+                "GNOME Remote Desktop RDP credentials",
+                builder.end ().print (true),
+                null
+            );
+        }
+
+        public async void set_enabled (bool enabled) throws Error {
+            var systemd = yield Bus.get_proxy<SystemdManager> (BusType.SESSION, "org.freedesktop.systemd1", "/org/freedesktop/systemd1");
+
+            if (enabled) {
+                yield ensure_credentials ();
+                ensure_certificate ();
+                rdp_settings.set_boolean ("enable", true);
+
+                bool carries_install_info;
+                UnitFileChange[] changes;
+                yield systemd.enable_unit_files ({ SERVICE }, false, false, out carries_install_info, out changes);
+                yield systemd.start_unit (SERVICE, "replace");
+                return;
+            }
+
+            rdp_settings.set_boolean ("enable", false);
+
+            // The same daemon also serves VNC, leave it running if that is still in use
+            if (SettingsSchemaSource.get_default ().lookup (VNC_SCHEMA, true) != null && new Settings (VNC_SCHEMA).get_boolean ("enable")) {
+                return;
+            }
+
+            UnitFileChange[] changes;
+            yield systemd.disable_unit_files ({ SERVICE }, false, out changes);
+            yield systemd.stop_unit (SERVICE, "replace");
+        }
+
+        private async void ensure_credentials () throws Error {
+            string? username, password;
+            yield get_credentials (out username, out password);
+
+            if (username == null || username == "" || password == null || password == "") {
+                var generated_password = generate_password ();
+                if (generated_password == null) {
+                    throw new IOError.FAILED ("Failed to generate a password");
+                }
+
+                yield set_credentials (Environment.get_user_name (), generated_password);
+            }
+        }
+
+        private void ensure_certificate () throws Error {
+            var cert_path = rdp_settings.get_string ("tls-cert");
+            var key_path = rdp_settings.get_string ("tls-key");
+            if (cert_path != "" && key_path != "" && FileUtils.test (cert_path, EXISTS) && FileUtils.test (key_path, EXISTS)) {
+                return;
+            }
+
+            // Same location GNOME Settings uses, so both share one certificate
+            var dir = Path.build_filename (Environment.get_user_data_dir (), "gnome-remote-desktop");
+            DirUtils.create_with_parents (dir, 0700);
+
+            cert_path = Path.build_filename (dir, "rdp-tls.crt");
+            key_path = Path.build_filename (dir, "rdp-tls.key");
+            generate_tls_certificate (cert_path, key_path, "GNOME");
+
+            rdp_settings.set_string ("tls-cert", cert_path);
+            rdp_settings.set_string ("tls-key", key_path);
+        }
+    }
+}
