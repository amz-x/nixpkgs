+    private void on_interface_appeared (DBusConnection connection, string name, string name_owner) {
+        Bus.get_proxy.begin<WingpanelInterface> (SESSION, name, "/io/elementary/gala/WingpanelInterface", NONE, null, (obj, res) => {
+            try {
+                var proxy = Bus.get_proxy.end<WingpanelInterface> (res);
+                bool caps_lock, num_lock;
+                proxy.get_lock_state (out caps_lock, out num_lock);
+
+                proxy.lock_state_changed.connect (update_lock_state);
+                wingpanel_interface = proxy;
+                update_lock_state (caps_lock, num_lock);
+            } catch (Error e) {
+                // Older compositor plugin without lock state support
+                debug ("Unable to get lock state from compositor: %s", e.message);
+            }
+        });
+    }
+
+    private void on_interface_vanished (DBusConnection? connection, string name) {
+        wingpanel_interface = null;
+        update_lock_state_from_device ();
+    }
+
+    private void update_lock_state_from_device () {
+        update_lock_state (device.get_caps_lock_state (), device.get_num_lock_state ());
+    }
+
+    private void update_lock_state (bool caps_lock, bool num_lock) {
+        caps_lock_state = caps_lock;
+        num_lock_state = num_lock;
+        update_visibility ();
+    }
+
     public override Gtk.Widget? get_widget () {
         return popover_widget;
     }
