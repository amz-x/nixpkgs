+    private AppInfo? get_appinfo_from_unit (string unit) {
+        if (!unit.has_prefix ("app-")) {
+            return null;
+        }
+
+        string name;
+        if (unit.has_suffix (".service")) {
+            name = unit.substring (4, unit.length - 4 - ".service".length);
+            var at = name.index_of_char ('@');
+            if (at >= 0) {
+                name = name.substring (0, at);
+            }
+        } else if (unit.has_suffix (".scope")) {
+            name = unit.substring (4, unit.length - 4 - ".scope".length);
+            var dash = name.last_index_of_char ('-');
+            if (dash >= 0) {
+                name = name.substring (0, dash);
+            }
         } else {
             return null;
         }
+
+        name = unescape_unit_name (name);
+
+        // Strip the optional launcher prefix ("gnome-", "flatpak-", ...) if the full name doesn't match
+        while (true) {
+            var app_info = new DesktopAppInfo (name + ".desktop");
+            if (app_info != null) {
+                return app_info;
+            }
+
+            var dash = name.index_of_char ('-');
+            if (dash < 0) {
+                return null;
+            }
+
+            name = name.substring (dash + 1);
+        }
+    }
+
+    private static string unescape_unit_name (string name) {
+        var builder = new StringBuilder ();
+        for (int i = 0; i < name.length; i++) {
+            if (name[i] == '\\' && i + 3 < name.length && name[i + 1] == 'x') {
+                builder.append_c ((char) (name[i + 2].xdigit_value () * 16 + name[i + 3].xdigit_value ()));
+                i += 3;
+            } else {
+                builder.append_c (name[i]);
+            }
+        }
+
+        return builder.str;
+    }
