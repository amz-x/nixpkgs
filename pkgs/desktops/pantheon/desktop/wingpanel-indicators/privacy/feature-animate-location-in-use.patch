+    private void on_client_signal (
+        DBusConnection conn,
+        string? sender,
+        string object_path,
+        string interface_name,
+        string signal_name,
+        Variant parameters
+    ) {
+        if (interface_name == GEOCLUE_CLIENT_INTERFACE && signal_name == "LocationUpdated") {
+            finish_request (object_path);
+            return;
+        }
+
+        if (interface_name != "org.freedesktop.DBus.Properties" || signal_name != "PropertiesChanged") {
+            return;
+        }
+
+        if (!parameters.is_of_type (new VariantType ("(sa{sv}as)")) ||
+            parameters.get_child_value (0).get_string () != GEOCLUE_CLIENT_INTERFACE) {
+            return;
+        }
+
+        var active = parameters.get_child_value (1).lookup_value ("Active", VariantType.BOOLEAN);
+        if (active == null) {
+            return;
+        }
+
+        if (active.get_boolean ()) {
+            start_request (object_path);
+        } else {
+            finish_request (object_path);
+        }
+    }
+
+    private void start_request (string client_path) {
+        uint old_id;
+        if (pending_requests.unset (client_path, out old_id)) {
+            Source.remove (old_id);
+        }
+
+        var timeout_id = Timeout.add_seconds (REQUEST_TIMEOUT_SECONDS, () => {
+            pending_requests.unset (client_path);
+            update_requesting ();
+            return Source.REMOVE;
+        });
+        pending_requests[client_path] = timeout_id;
+        update_requesting ();
+    }
+
+    private void finish_request (string client_path) {
+        uint timeout_id;
+        if (pending_requests.unset (client_path, out timeout_id)) {
+            Source.remove (timeout_id);
+            update_requesting ();
+        }
+    }
+
+    private void clear_requests () {
+        foreach (var timeout_id in pending_requests.values) {
+            Source.remove (timeout_id);
+        }
+        pending_requests.clear ();
+        update_requesting ();
+    }
+
+    private bool requesting = false;
+
+    private void update_requesting () {
+        var now_requesting = !pending_requests.is_empty;
+        if (now_requesting != requesting) {
+            requesting = now_requesting;
+            requesting_changed (requesting);
+        }
+    }
 }
