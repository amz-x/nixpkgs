diff --git a/src/Widgets/AppIcon.vala b/src/Widgets/AppIcon.vala
new file mode 100644
index 0000000..d30ed35
--- /dev/null
+++ b/src/Widgets/AppIcon.vala
@@ -0,0 +1,120 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * SPDX-FileCopyrightText: 2026 elementary, Inc. (https://elementary.io)
+ */
+
+/*
+ * An application icon that never puts high bit depth textures into the
+ * render tree.
+ *
+ * A single 16 bit or floating point texture (for example a 16 bit PNG
+ * application icon) switches GTK's GPU renderer to high depth
+ * intermediates for the whole frame. In that mode, SVG icons using filters
+ * like <feFlood flood-opacity="0"/> + <feBlend/> render as black squares,
+ * since the blend of two transparent pixels is NaN, which no longer gets
+ * flushed to 0. Since the grid shows many unrelated icons in one frame, one
+ * app's icon would break another's, so raster icons are converted to 8 bit.
+ */
+public class Slingshot.AppIcon : Gtk.Widget {
+    public GLib.Icon? gicon { get; set; }
+    public int pixel_size { get; construct; }
+
+    private Gtk.Image image;
+
+    public AppIcon (int pixel_size) {
+        Object (pixel_size: pixel_size);
+    }
+
+    class construct {
+        set_layout_manager_type (typeof (Gtk.BinLayout));
+    }
+
+    construct {
+        image = new Gtk.Image () {
+            pixel_size = pixel_size
+        };
+        image.set_parent (this);
+
+        notify["gicon"].connect (update);
+        notify["scale-factor"].connect (update);
+        Gtk.IconTheme.get_for_display (Gdk.Display.get_default ()).changed.connect (update);
+    }
+
+    public override void dispose () {
+        image.unparent ();
+        base.dispose ();
+    }
+
+    private void update () {
+        image.gicon = gicon;
+
+        if (gicon == null) {
+            return;
+        }
+
+        unowned var theme = Gtk.IconTheme.get_for_display (Gdk.Display.get_default ());
+        var icon_paintable = theme.lookup_by_gicon (gicon, pixel_size, scale_factor, get_direction (), 0);
+        var file = icon_paintable.file;
+        if (file == null) {
+            return;
+        }
+
+        // Only PNG icons can have more than 8 bits per channel. Leave symbolic
+        // ones to GTK, which recolors them.
+        var basename = file.get_basename ().down ();
+        if (!basename.has_suffix (".png") || basename.has_suffix ("-symbolic.png") || basename.has_suffix (".symbolic.png")) {
+            return;
+        }
+
+        Gdk.Texture texture;
+        try {
+            texture = Gdk.Texture.from_file (file);
+        } catch (Error e) {
+            return;
+        }
+
+        if (!is_high_depth (texture.get_format ())) {
+            return;
+        }
+
+        var downloader = new Gdk.TextureDownloader (texture);
+        downloader.set_format (R8G8B8A8_PREMULTIPLIED);
+
+        size_t stride;
+        var bytes = downloader.download_bytes (out stride);
+
+        image.paintable = new Gdk.MemoryTexture (
+            texture.width,
+            texture.height,
+            R8G8B8A8_PREMULTIPLIED,
+            bytes,
+            stride
+        );
+    }
+
+    private static bool is_high_depth (Gdk.MemoryFormat format) {
+        switch (format) {
+            case B8G8R8A8_PREMULTIPLIED:
+            case A8R8G8B8_PREMULTIPLIED:
+            case R8G8B8A8_PREMULTIPLIED:
+            case A8B8G8R8_PREMULTIPLIED:
+            case B8G8R8A8:
+            case A8R8G8B8:
+            case R8G8B8A8:
+            case A8B8G8R8:
+            case B8G8R8X8:
+            case X8R8G8B8:
+            case R8G8B8X8:
+            case X8B8G8R8:
+            case R8G8B8:
+            case B8G8R8:
+            case G8A8_PREMULTIPLIED:
+            case G8A8:
+            case G8:
+            case A8:
+                return false;
+            default:
+                return true;
+        }
+    }
+}
