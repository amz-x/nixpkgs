     private void add_battery (string device_path, Services.Device battery) {
+        // UPower can announce a path that is already listed (e.g. a Bluetooth
+        // headset reconnecting); replace its row instead of adding another.
+        remove_battery (device_path);
+
         var device_row = new Power.Widgets.DeviceRow (battery);
 
