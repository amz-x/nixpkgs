+
+        // The greeter maximizes before the panel reserves its strut. When it maps
+        // mutter moves it below the panel but keeps the size the client committed,
+        // pushing its bottom off screen, so fit it to the work area ourselves.
+        window.shown.connect (fit_greeter_to_work_area);
+        var workareas_changed_id = window.display.workareas_changed.connect (() => fit_greeter_to_work_area (window));
+        window.unmanaging.connect ((_window) => _window.display.disconnect (workareas_changed_id));
+    }
+
+    private static void fit_greeter_to_work_area (Meta.Window window) {
+        if (!window.mapped) {
+            return;
+        }
+
+        var work_area = window.get_work_area_current_monitor ();
+        if (window.get_frame_rect ().equal (work_area)) {
+            return;
+        }
+
+        window.move_resize_frame (false, work_area.x, work_area.y, work_area.width, work_area.height);
     }
 
