+    // With the cursor hidden, pointer events don't reach us, so a mouse
+    // movement, click or scroll wouldn't bring up the greeter. Like
+    // gnome-shell's screen shield, notice any input via the idle monitor.
+    private void watch_user_active () {
+        if (user_active_watch != 0) {
+            return;
+        }
+
+        unowned var idle_monitor = wm.get_display ().get_context ().get_backend ().get_core_idle_monitor ();
+        user_active_watch = idle_monitor.add_user_active_watch (() => {
+            // User active watches only fire once
+            user_active_watch = 0;
+            on_user_became_active ();
+        });
+    }
+
+    private void unwatch_user_active () {
+        if (user_active_watch == 0) {
+            return;
+        }
+
+        unowned var idle_monitor = wm.get_display ().get_context ().get_backend ().get_core_idle_monitor ();
+        idle_monitor.remove_watch (user_active_watch);
+        user_active_watch = 0;
+    }
+
     private void cancel_animation () {
