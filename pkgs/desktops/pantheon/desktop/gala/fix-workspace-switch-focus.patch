diff --git a/src/Widgets/MultitaskingView/MultitaskingView.vala b/src/Widgets/MultitaskingView/MultitaskingView.vala
index 06d3ec2..c019706 100644
--- a/src/Widgets/MultitaskingView/MultitaskingView.vala
+++ b/src/Widgets/MultitaskingView/MultitaskingView.vala
@@ -272,7 +272,16 @@ public class Gala.MultitaskingView : Root, RootTarget {
             modal_proxy = wm.push_modal (get_stage (), false);
             modal_proxy.allow_actions (MULTITASKING_VIEW | SWITCH_WORKSPACE | ZOOM | LOCATE_POINTER | MEDIA_KEYS | SCREENSHOT | SCREENSHOT_AREA);
             modal_proxy.allow_window_groups (ALLOWED_WINDOW_GROUPS);
+            /* While only animating a workspace switch, leave the focus to mutter:
+               unsetting it would unfocus the window mutter focuses on the new
+               workspace, and X11 clients like Wine may not take the later
+               refocus, leaving the window without keyboard focus */
+            modal_proxy.allow_window_focus = action == SWITCH_WORKSPACE;
         } else if (action == MULTITASKING_VIEW) {
+            if (modal_proxy != null) {
+                modal_proxy.allow_window_focus = false;
+            }
+
             DragDropAction.cancel_all_by_id ("multitaskingview-window");
         }
 
