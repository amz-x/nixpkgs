index 158bcff..3f8003a 100644
--- a/src/PanelWindow.vala
+++ b/src/PanelWindow.vala
@@ -62,6 +62,19 @@ public class Wingpanel.PanelWindow : Gtk.Window {
             }
         });
 
+        // The popover doesn't autohide, so it never takes focus and its own
+        // Escape handling isn't reached unless an indicator focused a child
+        var key_controller = new Gtk.EventControllerKey ();
+        key_controller.key_pressed.connect ((keyval) => {
+            if (keyval == Gdk.Key.Escape && popover_manager.indicator_open) {
+                popover_manager.current_indicator = null;
+                return Gdk.EVENT_STOP;
+            }
+
+            return Gdk.EVENT_PROPAGATE;
+        });
+        ((Gtk.Widget) this).add_controller (key_controller);
+
         Services.BackgroundManager.get_default ().background_state_changed.connect (update_background);
     }
 
