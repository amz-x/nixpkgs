diff --git a/wingpanel-interface/DBusServer.vala b/wingpanel-interface/DBusServer.vala
index a157ecf..23ed6c5 100644
--- a/wingpanel-interface/DBusServer.vala
+++ b/wingpanel-interface/DBusServer.vala
@@ -23,6 +23,22 @@ public class WingpanelInterface.DBusServer : Object {
     private FocusManager focus_manager;
 
     public signal void state_changed (BackgroundState state, uint animation_duration);
+    public signal void lock_state_changed (bool caps_lock, bool num_lock);
+
+    private Clutter.Keymap keymap;
+
+    construct {
+#if HAS_MUTTER48
+        keymap = Main.display.get_compositor ().get_stage ().context.get_backend ().get_default_seat ().get_keymap ();
+#elif HAS_MUTTER47
+        keymap = Main.display.get_stage ().context.get_backend ().get_default_seat ().get_keymap ();
+#else
+        keymap = Clutter.get_default_backend ().get_default_seat ().get_keymap ();
+#endif
+        keymap.state_changed.connect (() => {
+            lock_state_changed (keymap.get_caps_lock_state (), keymap.get_num_lock_state ());
+        });
+    }
 
     public void initialize (int panel_height) throws GLib.Error {
         background_manager = new BackgroundManager (panel_height);
@@ -44,4 +60,13 @@ public class WingpanelInterface.DBusServer : Object {
     public void restore_focused_window () throws GLib.Error {
         focus_manager.restore_focused_window ();
     }
+
+    /*
+     * Panel surfaces never hold keyboard focus on Wayland, so clients can't
+     * track lock key state themselves and need to ask the compositor.
+     */
+    public void get_lock_state (out bool caps_lock, out bool num_lock) throws GLib.Error {
+        caps_lock = keymap.get_caps_lock_state ();
+        num_lock = keymap.get_num_lock_state ();
+    }
