@@ -114,7 +114,18 @@ public class Event : Object
 {
     public const string SIGNATURE = "asaasay";
 
+    // Shared by every thread that builds events (Log runs direct DB reads
+    // on a thread pool), but GStringChunk is not thread-safe.
     private static StringChunk url_store;
+    private static Mutex url_store_lock;
+
+    private static unowned string intern (string value)
+    {
+        url_store_lock.lock ();
+        unowned string result = url_store.insert_const (value);
+        url_store_lock.unlock ();
+        return result;
+    }
 
