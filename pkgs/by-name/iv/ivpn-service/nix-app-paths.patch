+// LookPath resolves a binary like exec.LookPath, then falls back to the NixOS
+// profile directories. The daemon runs as a systemd service whose PATH does not
+// contain them, while desktop entries usually refer to binaries by name only.
+// When `home` is known only the profiles of the user owning it are searched,
+// otherwise the profiles of all users are.
+func LookPath(file string, home string) (string, error) {
+	ret, err := exec.LookPath(file)
+	if err == nil || strings.Contains(file, "/") {
+		return ret, err
+	}
+
+	dirs := []string{"/run/current-system/sw/bin"}
+	if len(home) > 0 {
+		if fi, statErr := os.Stat(home); statErr == nil {
+			if st, ok := fi.Sys().(*syscall.Stat_t); ok {
+				if u, uErr := user.LookupId(fmt.Sprint(st.Uid)); uErr == nil {
+					dirs = append(dirs, path.Join("/etc/profiles/per-user", u.Username, "bin"))
+				}
+			}
+		}
+		dirs = append(dirs,
+			path.Join(home, ".nix-profile", "bin"),
+			path.Join(home, ".local", "state", "nix", "profile", "bin"),
+			path.Join(home, ".local", "share", "flatpak", "exports", "bin"))
+	} else {
+		for _, pattern := range []string{
+			"/etc/profiles/per-user/*/bin",
+			"/home/*/.nix-profile/bin",
+			"/home/*/.local/state/nix/profile/bin",
+			"/home/*/.local/share/flatpak/exports/bin",
+		} {
+			if matches, globErr := filepath.Glob(pattern); globErr == nil {
+				dirs = append(dirs, matches...)
+			}
+		}
+	}
+	dirs = append(dirs, "/nix/var/nix/profiles/default/bin", "/var/lib/flatpak/exports/bin")
+
+	for _, dir := range dirs {
+		candidate := filepath.Join(dir, file)
+		if fi, statErr := os.Stat(candidate); statErr == nil && !fi.IsDir() && fi.Mode()&0111 != 0 {
+			return candidate, nil
+		}
+	}
+	return "", err
+}
